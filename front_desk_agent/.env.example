ANTHROPIC_API_KEY="sk-ant-"

# ElevenLabs — dramatically better voice quality for Zara (optional, falls back to gTTS)
# Get your free key at https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ─── PHASE 1: TWILIO PHONE ──────────────────────────────────────────────────
# Sign up at https://console.twilio.com → buy a number (~$1.15/mo)
# Then copy your Account SID, Auth Token, and the number you bought.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# Your personal cell number. Calls from this number auto-route to OWNER mode.
# Must be in E.164 format (+countrycode...).
OWNER_PHONE_NUMBER=+1XXXXXXXXXX

# Default mode for unknown callers: visitor | outreach | owner
DEFAULT_INBOUND_MODE=visitor

# Twilio TTS voice. Polly.Joanna-Neural is a sharp female voice.
# Other good options: Polly.Matthew-Neural (male), Polly.Salli-Neural, Polly.Ivy-Neural
# For best quality, later we'll swap to ElevenLabs via <Play>.
TWILIO_TTS_VOICE=Polly.Joanna-Neural

# Server port (leave default unless conflict)
PORT=5001
