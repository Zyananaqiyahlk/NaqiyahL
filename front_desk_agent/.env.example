# ─── REQUIRED ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# ─── VOICE — Edge TTS is free, no key needed ─────────────────────────────────
# Override the default voice if you want (run: edge-tts --list-voices)
# EDGE_TTS_VOICE=en-CA-ClaraNeural

# ─── TWILIO (phone calls — inbound + outbound) ────────────────────────────────
# Get these at https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx      # Your Twilio phone number
OWNER_PHONE_NUMBER=+1xxxxxxxxxx      # Your personal cell — routes calls to owner mode
DEFAULT_INBOUND_MODE=visitor         # visitor | outreach | owner

# ─── APOLLO (lead search + enrichment) ────────────────────────────────────────
# Get key at https://app.apollo.io → Settings → Integrations → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# ─── RAILWAY (hosting) ────────────────────────────────────────────────────────
# Set this after Railway deploys your app — copy from your Railway dashboard
RAILWAY_PUBLIC_DOMAIN=https://zara-production.up.railway.app

# Random string to protect your REST API endpoints (generate anything long)
API_SECRET=your_random_secret_here

# ─── POSTGRES (Railway adds this automatically) ───────────────────────────────
# When set, all data is stored in Postgres instead of JSON files.
# Copy this from Railway dashboard → your Postgres service → Connect tab.
# DATABASE_URL=postgresql://user:password@host:5432/railway
